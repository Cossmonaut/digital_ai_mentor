# ===========================================
# Шаблон переменных окружения для Digital Mentor
# Скопируйте этот файл в src/api_keys.env и заполните значения
# ===========================================

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token_here

# --- API Keys для LLM провайдеров ---
CLOUD_RU_API_KEY=your_cloud_ru_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here
GIGACHAT_API_KEY=your_gigachat_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Neo4j Database ---
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_URL=bolt://neo4j:7687

# --- Redis Cache ---
REDIS_URL=redis://redis_cache:6379
REDIS_TTL=86400

# --- LLM Parameters ---
MAIN_LLM_MODEL=anthropic/claude-sonnet-4.6
MAIN_LLM_BASE=https://foundation-models.api.cloud.ru/v1
MAIN_LLM_TIMEOUT=60
MAIN_LLM_TEMPERATURE=0.1

# --- Cache ---
CACHE_TTL_SECONDS=3600

# --- Logging ---
LOG_LEVEL=INFO

# --- Proxy (если нужен для доступа к Telegram/API) ---
# PROXY_URL=http://host.docker.internal:1443