# Игнорировать все файлы с расширением .env
*.env
.env.local
.env.*.local
digital_venv/
api_keys.env
# Игнорируем файлы локальной базы данных Neo4j
neo4j_data/
neo4j_logs/

# Исключение: разрешить отслеживать только шаблон настроек
!.env.example

# === Секреты и конфигурационные данные ===
# Категорически скрываем API-ключи и параметры графа
src/api_keys.env
utils/graph_params.json

# === Тяжёлый локальный кэш моделей (2+ ГБ) ===
# На сервере эти файлы подтянутся автоматически
src/hf_models_cache/
utils/hf_models_cache/

# === Временные файлы Docker и базы данных ===
# Игнорируем случайно созданную папку с опечаткой в имени
neo4j_data*

# === Старые файлы и черновики (по желанию) ===
# Если хотите запушить ваши Jupyter Notebook для истории,
# удалите строки ниже. Если они не нужны на сервере — оставьте.
src/test.ipynb
src/knowledge_base.py
src/llm.py
src/main.py
utils/graphrag.ipynb


# === Исходные тяжёлые PDF-документы ===
# В базу данных заливаются только готовые .txt файлы
data/raw/

# === Системный мусор Python и ОС ===
__pycache__/
*/__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

# === Виртуальные окружения ===
*venv*
env/
